div.mx-auto.mt-5 style="max-width: 720px;"
  div.card.text-white.border-0.mb-5
    div.card-header.card-header-color.py-3
      p.p-1.fs-4.mb-0
        i.bi.bi-person-hearts.me-2
        | #{@user_character.character_type.name}

    div.card-body.card-body-color.p-4
      div.d-flex.align-items-end.gap-4.mb-4.character-page-header
        = image_tag(@user_character.character_type.image_path, alt: @user_character.name, width: 260, class: 'character-page-avatar')

        div.flex-grow-1.d-flex.flex-column.gap-3.character-page-content
          div.collapse id="gift_item_panel"
            div.gift-item-panel.rounded.p-3
              - if @user_gift_items.empty?
                p.text-center.mb-0 style="color: rgba(255, 255, 255, 0.75);"
                  | まだプレゼントを持っていません。
                  br
                  | マイレージショップやタスク報酬で手に入れましょう！
              - else
                div
                  - @user_gift_items.each do |user_gift_item|
                    div.divider-row.d-flex.justify-content-between.align-items-center.px-2 data-bs-toggle="modal" data-bs-target="#gift_modal_#{user_gift_item.id}" style="cursor: pointer;"
                      div.d-flex.align-items-center.gap-3
                        = image_tag user_gift_item.gift_item.image_path, alt: user_gift_item.gift_item.name, width: 48, height: 48, class: 'rounded', style: 'object-fit: contain;'
                        div id="gift_item_#{user_gift_item.id}" data-bs-toggle="tooltip" title="+#{user_gift_item.gift_item.friendship_point}p" data-controller="tooltip"
                          div.text-white = user_gift_item.gift_item.name
                          div.small style="color: rgba(255, 255, 255, 0.75);" = "所持数：#{user_gift_item.quantity}"
                      i.bi.bi-chevron-right.text-muted-steam

                    div.modal.fade id="gift_modal_#{user_gift_item.id}" tabindex="-1" data-controller="gift-modal"
                      div.modal-dialog
                        div.modal-content.bg-dark.text-white
                          div.modal-header.border-secondary
                            div
                              h5.modal-title.mb-1 = user_gift_item.gift_item.name
                              div.small.text-muted-steam = "所持数：#{user_gift_item.quantity}"
                            button.btn-close.btn-close-white type="button" data-bs-dismiss="modal" aria-label="Close"
                          div.modal-body
                            p.text-white.mb-1 style="white-space: pre-line;" = user_gift_item.gift_item.description
                            p.small.text-muted-steam.mb-3
                              i.bi.bi-heart-fill.me-1
                              | +#{user_gift_item.gift_item.friendship_point}ポイント
                            = form_with url: present_gift_user_character_gift_items_path(@user_character), method: :patch, data: { action: 'turbo:submit-end->gift-modal#close' } do |f|
                              = f.hidden_field :gift_item_id, value: user_gift_item.gift_item_id
                              div.mb-3
                                label.form-label 個数
                                = f.number_field :count, value: 1, min: 1, max: user_gift_item.quantity, class: 'form-control search-input'
                              div.d-flex.justify-content-end.gap-2
                                button.btn.btn-secondary.text-white type="button" data-bs-dismiss="modal" style="width: 130px;" やめておく
                                = f.submit 'プレゼントする', class: 'btn btn-steam-signin', style: 'width: 130px; white-space: nowrap; text-align: center; padding-left: 0; padding-right: 0;'

          div#dom_id
            div.speech-bubble
              div.speech-bubble-content
                p.mb-0 #{@character_text.text}

      div.row.g-4.align-items-stretch
        div.col-lg-7
          div.h-100.p-3.rounded.stat-tile
            div.d-flex.align-items-end.gap-3
              div.friendship-heart
                i.bi.bi-heart-fill
                span.friendship-heart-level = @user_character.current_friendship_level
              div.flex-grow-1
                div.d-flex.justify-content-between.small.text-white.mb-2
                  span 好感度
                  - if @user_character.max_friendship_level?
                    span MAX
                  - else
                    span = "#{@user_character.friendship_point_within_current_level}/#{@user_character.friendship_point_required_for_current_level}"
                div.friendship-bar-track
                  div.friendship-bar-fill style="width: #{@user_character.friendship_point_progress_percent}%"

        div.col-lg-5.d-flex.gap-4
          = link_to communicate_user_character_path, data: { turbo_stream: true }, class: 'btn btn-color text-white rounded-4 flex-grow-1 h-100 d-flex align-items-center justify-content-center' do
            i.bi.bi-chat-dots-fill.me-2
            | 話す
          div.d-flex.flex-column.gap-3.flex-grow-1
            button.btn.btn-color.text-white.rounded-4.flex-grow-1.d-flex.align-items-center.justify-content-center type="button" data-bs-toggle="collapse" data-bs-target="#gift_item_panel"
              i.bi.bi-gift-fill.me-2
              | プレゼントを渡す
            button.btn.btn-secondary.text-white.rounded-4.flex-grow-1.d-flex.align-items-center.justify-content-center type="button" disabled=true title="近日公開予定"
              i.bi.bi-palette-fill.me-2
              | 衣装を変更する
