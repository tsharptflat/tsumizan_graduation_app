div.card.text-white.border-0.mx-auto.mt-5 style="max-width: 720px;"
  div.card-header.card-header-color.py-3
    p.p-1.fs-4.mb-0
      i.bi.bi-controller.me-2
      | プレイ状況

  div.card-body.card-body-color
    h5.text-white
      i.bi.bi-play-fill.me-2
      | 今プレイ中のゲーム
    div.d-flex.flex-column.mb-4
      - (1..UserGameLibrary::NOW_PLAYING_LIMIT).each do |i|
        - library = @now_playing_libraries[i - 1]
        div.divider-row
          - if library
            div.d-flex.align-items-start.justify-content-between.play-row
              div.play-row-grid
                div.play-row-grid-img
                  = link_to game_path(library.game) do
                    = image_tag steam_banner_image(library.game), class: 'w-100 rounded mb-1 play-row-banner-img', onerror: "this.onerror=null;this.src='#{broken_thumbnail_placeholder}'"
                div.play-row-grid-badge
                  - if library.cleared_date
                    span.badge.status-badge.bg-success クリア済み
                  - else
                    span.badge.status-badge.badge-unclear 未クリア
                div.play-row-grid-title
                  = link_to library.game.game_title, game_path(library.game), class: 'link-steam-accent fw-bold'
                div.play-row-grid-stats
                  div.d-flex.gap-4
                    div
                      div.small.text-muted-steam プレイ時間
                      div.fw-bold = "#{(library.minutes_played / 60.0).round(1)}時間"
                    div
                      div.small.text-muted-steam 価格
                      div.fw-bold = "¥#{library.game.price}"
                    - if library.unplayed_date && library.cleared_date.nil?
                      div
                        div.small.text-muted-steam 積み時間
                        div.fw-bold = "#{(Date.current - library.unplayed_date).to_i}日"
              div.d-flex.flex-column.justify-content-center.gap-1.play-row-actions
                = button_to clear_slot_play_focus_path(library_id: library.id), method: :patch, class: "btn btn-secondary text-white btn-sm w-100" do
                  span.d-none.d-md-inline 取り下げる
                  i.bi.bi-x.d-md-none
                - if library.cleared_date
                  = button_to "未クリアに戻す", revert_cleared_games_play_focus_path(library_id: library.id), method: :patch, class: "btn btn-color text-white btn-sm w-100"
                - else
                  = button_to "クリアにする", update_cleared_games_play_focus_path(library_id: library.id), method: :patch, class: "btn btn-color text-white btn-sm w-100"
          - else
            = link_to "ゲームを選択", picker_play_focus_path(slot: 'now_playing'), class: "btn btn-color text-white"

    h5.text-white
      i.bi.bi-skip-forward-fill.me-2
      | 次にプレイするゲーム
    div.divider-row
      - if @next_up_library
        div.d-flex.align-items-start.justify-content-between.play-row
          div.play-row-grid
            div.play-row-grid-img
              = link_to game_path(@next_up_library.game) do
                = image_tag steam_banner_image(@next_up_library.game), class: 'w-100 rounded mb-1 play-row-banner-img', onerror: "this.onerror=null;this.src='#{broken_thumbnail_placeholder}'"
            div.play-row-grid-title
              = link_to @next_up_library.game.game_title, game_path(@next_up_library.game), class: 'link-steam-accent fw-bold'
            div.play-row-grid-stats
              div.d-flex.gap-4
                div
                  div.small.text-muted-steam プレイ時間
                  div.fw-bold = "#{(@next_up_library.minutes_played / 60.0).round(1)}時間"
                div
                  div.small.text-muted-steam 価格
                  div.fw-bold = "¥#{@next_up_library.game.price}"
          div.d-flex.flex-column.justify-content-center.gap-1.play-row-actions
            = button_to clear_slot_play_focus_path(library_id: @next_up_library.id), method: :patch, class: "btn btn-secondary text-white btn-sm w-100" do
              span.d-none.d-md-inline 取り下げる
              i.bi.bi-x.d-md-none
      - else
        = link_to "ゲームを選択", picker_play_focus_path(slot: 'next_up'), class: "btn btn-color text-white"
