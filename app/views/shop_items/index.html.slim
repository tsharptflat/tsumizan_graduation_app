div.mx-auto.mt-5 style="max-width: 720px;" data-controller="shop-preview"
  div.d-flex.justify-content-between.align-items-center.mb-3
    = link_to '< 戻る', user_path(current_user), class: 'btn btn-secondary text-white rounded-pill px-4'
    span.text-white
      i.bi.bi-coin.me-1
      span#user_wallet_point = "#{current_user.user_wallet.point}P"

  div.card.text-white.border-0.mb-5
    div.card-header.card-header-color.py-3
      p.p-1.fs-4.mb-0
        i.bi.bi-shop-window.me-2
        | マイレージショップ

    div.card-body.card-body-color
      div.row.g-4
        div.col-lg-5
          - first_item = @shop_items.first&.item
          div.p-3.rounded.stat-tile.position-relative
            = image_tag(first_item&.image_path, data: { shop_preview_target: 'image' }, alt: 'アイテム画像', class: 'w-100 rounded mb-2', style: 'height: 200px; object-fit: cover;')
            p.text-white.small.mb-0 data-shop-preview-target="description" = first_item&.description
            div.toast.fade.position-absolute.top-100.start-50.translate-middle-x.mt-2 id="purchase_toast" role="status" aria-live="polite" aria-atomic="true" data-bs-autohide="true" data-bs-delay="3000"
              div.toast-body

        div.col-lg-7
          div.shop-item-list
            - @shop_items.each do |shop_item|
              - owned = shop_item_owned?(shop_item, @owned_outfit_item_ids)
              - if owned
                div.divider-row.d-flex.justify-content-between.align-items-center
                  div
                    div.text-muted-steam = shop_item.item.name
                    div.small.text-muted-steam = shop_item.item.description
                  span.badge.status-badge.bg-success 所持済み
              - else
                div.divider-row.search-suggestion-item.rounded.px-2.d-flex.justify-content-between.align-items-center data-action="mouseover->shop-preview#show" data-bs-toggle="modal" data-bs-target="#shop_item_modal_#{shop_item.id}" data-shop-preview-image-param="#{shop_item.item.image_path}" data-shop-preview-description-param="#{shop_item.item.description}" style="cursor: pointer;"
                  div
                    div.text-white = shop_item.item.name
                    div.small.text-muted-steam = shop_item.item.description
                  span.link-steam-accent = "#{shop_item.price.to_i}P"

                - affordable_count = shop_item.affordable_count_for(current_user)
                - can_afford = affordable_count >= 1

                div.modal.fade id="shop_item_modal_#{shop_item.id}" tabindex="-1" data-controller="gift-modal point-calculator" data-point-calculator-per-item-value="#{shop_item.price.to_i}"
                  div.modal-dialog
                    div.modal-content.bg-dark.text-white
                      div.modal-header.border-secondary
                        div
                          h5.modal-title.mb-1 = "#{shop_item.item.name}を交換しますか？"
                          div.small.text-white
                            span data-point-calculator-target="total" = "#{shop_item.price.to_i}P"
                          - if shop_item.item_type == 'GiftItem'
                            div.small.text-muted-steam = "所持数：#{current_user.user_gift_items.find_by(gift_item_id: shop_item.item_id)&.quantity || 0}"
                        button.btn-close.btn-close-white type="button" data-bs-dismiss="modal" aria-label="Close"
                      div.modal-body
                        p.text-white.mb-1 = shop_item.item.description
                        - if shop_item.item_type == 'GiftItem'
                          p.small.text-muted-steam.mb-3
                            i.bi.bi-heart-fill.me-1
                            | +#{shop_item.item.friendship_point}ポイント
                        = form_with url: purchase_item_shop_item_path(shop_item), method: :patch, data: { action: 'turbo:submit-end->gift-modal#close' } do |f|
                          - if shop_item.item_type == 'GiftItem' && can_afford
                            div.mb-3
                              label.form-label 個数
                              = f.number_field :count, value: 1, min: 1, max: affordable_count, class: 'form-control search-input', data: { point_calculator_target: 'count', action: 'input->point-calculator#updateTotal' }
                          div.d-flex.justify-content-end.gap-2
                            button.btn.btn-secondary.text-white type="button" data-bs-dismiss="modal" style="width: 110px;" やめておく
                            - if can_afford
                              = f.submit '交換する', class: 'btn btn-steam-signin', style: 'width: 110px;'
                            - else
                              button.btn.btn-secondary.text-white type="button" disabled=true style="width: 110px;" 交換不可
