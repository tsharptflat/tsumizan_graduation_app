div.card.text-white.border-0.mx-auto.mt-5.card-body-color style="max-width: 720px;"
  div.card-header.card-header-color.py-3
    p.p-1.fs-4.mb-0
      i.bi.bi-people-fill.me-2
      | みんなのゲーム一覧
    - current_sort = params[:sort].presence || 'possessed_count'
    div.d-flex.flex-wrap.gap-3.mt-2
      - [['名前順', 'name'], ['価格の安い順', 'price_asc'], ['価格の高い順', 'price_desc'], ['積み率順', 'unplayed_rate'], ['所持者数順', 'possessed_count']].each do |label, key|
        = link_to label, games_path(sort: key), class: key == current_sort ? 'text-white fw-bold' : 'link-steam-accent'
  div.card-body.card-body-color
    ol.list-unstyled.w-100.px-3
      - @games.each do |game|
        li.game-list-item
          div.d-flex.align-items-center.game-row.game-row-data
            div.game-row-info
              = link_to game_path(game) do
                = image_tag steam_banner_image(game), class: 'rounded game-row-banner', onerror: "this.onerror=null;this.src='#{broken_thumbnail_placeholder}'"
              div.d-inline-block.text-start.game-row-title-wrap
                = link_to game.game_title, game_path(game), class: 'link-steam-accent small d-block mt-1'
            div.game-row-stats
              div.game-row-stat
                div.small.text-muted-steam 所持者数
                div.fw-bold = "#{@all_games_count.fetch(game.id, 0)}人"
              div.game-row-stat
                div.small.text-muted-steam 価格
                div.fw-bold = "¥#{game.price}"
              div.game-row-stat
                div.small.text-muted-steam 積み率
                div.fw-bold = "#{UserGameLibrary.unplayed_rate_for(game, @all_games_count, @all_unplayed_games_count)}%"
    = paginate @games